# Machine-specific settings for BOTH dataset pipelines (Simulated_Data and
# Real_Data). This is the only file you need to edit to run either of them.
#
#   cd Dataset_Processing
#   cp env.sh.example env.sh
#   $EDITOR env.sh
#
# `bash setup_environments.sh` creates the conda environments below and writes
# this file for you, so copying it by hand is only needed if you already have
# the tools installed somewhere.
#
# env.sh is gitignored; env.sh.example is the version that ships in the repo.
# Every script in Simulated_Data/ and Real_Data/ reads this one file - the
# shell phases source it, the Python phases parse it - so a standalone
# `python 5_assemble_and_build_graph.py` sees exactly what `run_all.sh` sees.
#
# Anything already exported in your shell wins over this file, so a one-off
# override never needs an edit:
#
#   VB_THREADS=32 bash run_all.sh --tier low
#
# Delete a line (or the whole file) and the scripts fall back to the built-in
# default shown in each comment. Tool lookups also fall back to PATH, so an
# activated conda environment works with nothing set here.

# ============================================================================
# Conda environments
# ============================================================================
# Five environments rather than one, because the pins genuinely conflict:
# bioconda's samtools/htslib, megahit and geNomad each want library sets that
# viralbin's torch/PyG stack does not share. `setup_environments.sh` builds
# them; each variable below is the `bin/` directory of one env.

# mmseqs, checkv, flye, badread, and the python holding
# torch / torch_geometric / pysam / pyrodigal-gv / scikit-learn / pandas /
# networkx.                       Used by: both pipelines
#                                 default: $HOME/miniforge3/envs/viralbin/bin
export VB_CONDA_BIN="${VB_CONDA_BIN:-$HOME/miniforge3/envs/viralbin/bin}"

# metaspades.py, minimap2, samtools, seqkit (and pigz, if present).
#                                 Used by: both pipelines
#                                 default: $HOME/miniforge3/envs/asm_env/bin
export VB_ASM_CONDA_BIN="${VB_ASM_CONDA_BIN:-$HOME/miniforge3/envs/asm_env/bin}"

# prefetch, fasterq-dump (SRA toolkit).
#                                 Used by: Real_Data phase 1 only
#                                 default: $HOME/miniforge3/envs/sra_env/bin
export VB_SRA_CONDA_BIN="${VB_SRA_CONDA_BIN:-$HOME/miniforge3/envs/sra_env/bin}"

# genomad.                        Used by: Real_Data, viral_enriched=no rows
#                                 default: $HOME/miniforge3/envs/genomad_env/bin
export VB_GENOMAD_CONDA_BIN="${VB_GENOMAD_CONDA_BIN:-$HOME/miniforge3/envs/genomad_env/bin}"

# megahit.                        Used by: Real_Data, assembler=megahit rows
#                                 default: $HOME/miniforge3/envs/megahit_env/bin
export VB_MEGAHIT_CONDA_BIN="${VB_MEGAHIT_CONDA_BIN:-$HOME/miniforge3/envs/megahit_env/bin}"

# ============================================================================
# Databases
# ============================================================================
# Large downloads that no pipeline script fetches for you, so their location is
# a setting rather than a path under Data/. Both keep their historical,
# unprefixed names, since scripts and notebooks already read them.
# Real_Data only; the simulated pipeline needs neither.

# CheckV database directory - the one holding genome_db/ and hmm_db/.
#   "$VB_CONDA_BIN/checkv" download_database "$HOME/checkv-db"
#                                 default: $HOME/checkv-db/checkv-db-v1.5
export CHECKVDB="${CHECKVDB:-$HOME/checkv-db/checkv-db-v1.5}"

# geNomad database directory (~1.4 GB).
#   "$VB_GENOMAD_CONDA_BIN/genomad" download-database "$HOME/db/genomad"
#                                 default: $HOME/db/genomad/genomad_db
export GENOMAD_DB="${GENOMAD_DB:-$HOME/db/genomad/genomad_db}"

# ============================================================================
# Machine resources
# ============================================================================
export VB_THREADS="${VB_THREADS:-8}"      # CPU threads for download/assembly/mapping  default: 8
export VB_MEMORY_GB="${VB_MEMORY_GB:-10}" # assembler memory cap, in GB                default: 10
# VB_MEMORY_GB is a real cap, not a hint: an assembler allowed to take all of
# RAM leaves nothing for the page cache it needs while streaming compressed
# reads, which is what killed a MEGAHIT run here. Leave real headroom.

# ============================================================================
# What is deliberately NOT here
# ============================================================================
# Which dataset to build is a per-run choice, not a machine setting:
#
#   Simulated_Data:  bash run_all.sh --dataset low:iss:metaspades
#                    VB_TIER=low python 1_build_genome_pool.py
#   Real_Data:       bash run_all.sh --dataset lake_water   (rows in datasets.tsv)
